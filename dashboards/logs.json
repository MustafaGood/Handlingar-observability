{
    "uid":  "logs",
    "title":  "Logs",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "30s",
    "tags":  [
                 "handlingar"
             ],
    "time":  {
                 "from":  "now-6h",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "name":  "prometheus",
                                        "type":  "datasource",
                                        "query":  "prometheus",
                                        "refresh":  1,
                                        "hide":  0
                                    },
                                    {
                                        "name":  "loki",
                                        "type":  "datasource",
                                        "query":  "loki",
                                        "refresh":  1,
                                        "hide":  0
                                    },
                                    {
                                        "name":  "env",
                                        "label":  "env",
                                        "type":  "custom",
                                        "query":  "handlingar,tst,qat,handlingar-preview",
                                        "includeAll":  true,
                                        "allValue":  ".*",
                                        "multi":  false,
                                        "current":  {
                                                        "selected":  true,
                                                        "text":  "All",
                                                        "value":  "$__all"
                                                    }
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "type":  "logs",
                       "title":  "Rails 5xx",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "${loki}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  24,
                                       "x":  0,
                                       "y":  0
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "{namespace=~\"$env\", app=\"alaveteli\"} |~ \"Completed 5[0-9]{2}\"",
                                           "queryType":  "range"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  2,
                       "type":  "logs",
                       "title":  "Sidekiq errors",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "${loki}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  24,
                                       "x":  0,
                                       "y":  8
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "{namespace=~\"$env\", app=\"alaveteli-sidekiq\"} |~ \"(?i)(error|exception)\"",
                                           "queryType":  "range"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  3,
                       "type":  "logs",
                       "title":  "cert-manager errors",
                       "datasource":  {
                                          "type":  "loki",
                                          "uid":  "${loki}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  24,
                                       "x":  0,
                                       "y":  16
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "{namespace=\"cert-manager\"} |~ \"(?i)error\"",
                                           "queryType":  "range"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   }
               ]
}