{
    "uid":  "cluster",
    "title":  "Cluster",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "30s",
    "tags":  [
                 "handlingar"
             ],
    "time":  {
                 "from":  "now-6h",
                 "to":  "now"
             },
    "templating":  {
                       "list":  [
                                    {
                                        "name":  "prometheus",
                                        "type":  "datasource",
                                        "query":  "prometheus",
                                        "refresh":  1,
                                        "hide":  0
                                    },
                                    {
                                        "name":  "loki",
                                        "type":  "datasource",
                                        "query":  "loki",
                                        "refresh":  1,
                                        "hide":  0
                                    },
                                    {
                                        "name":  "env",
                                        "label":  "env",
                                        "type":  "custom",
                                        "query":  "handlingar,tst,qat,handlingar-preview",
                                        "includeAll":  true,
                                        "allValue":  ".*",
                                        "multi":  false,
                                        "current":  {
                                                        "selected":  true,
                                                        "text":  "All",
                                                        "value":  "$__all"
                                                    }
                                    }
                                ]
                   },
    "panels":  [
                   {
                       "id":  1,
                       "type":  "timeseries",
                       "title":  "Node CPU",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${prometheus}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  0,
                                       "y":  0
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percentunit"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  2,
                       "type":  "timeseries",
                       "title":  "Node memory",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${prometheus}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  8,
                                       "y":  0
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percentunit"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  3,
                       "type":  "timeseries",
                       "title":  "Node disk",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${prometheus}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  16,
                                       "y":  0
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\",mountpoint=\"/\"})"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percentunit"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  4,
                       "type":  "timeseries",
                       "title":  "Pod restarts",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${prometheus}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  0,
                                       "y":  8
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "increase(kube_pod_container_status_restarts_total{namespace=~\"$env\"}[1h])"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  5,
                       "type":  "stat",
                       "title":  "Pending pods",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${prometheus}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  8,
                                       "y":  8
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "kube_pod_status_phase{namespace=~\"$env\",phase=\"Pending\"}"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  6,
                       "type":  "timeseries",
                       "title":  "PVC fill",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${prometheus}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  8,
                                       "x":  16,
                                       "y":  8
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "kubelet_volume_stats_used_bytes{namespace=~\"$env\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$env\"}"
                                       }
                                   ],
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percentunit"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   }
               ]
}